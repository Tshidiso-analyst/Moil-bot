{
  "name": "moil-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Optional npm command wrapper for the Python-based Moil-bot application.",
  "scripts": {
    "install:python": "python -m pip install -r requirements.txt",
    "install:cloud": "python -m pip install -r requirements-render.txt",
    "dev": "python -m dashboard.app",
    "start": "python -m dashboard.app",
    "test": "python -m pytest -q",
    "demo:test": "python -m execution.demo_smoke_test",
    "backtest:mt5": "python -m backtesting.run_mt5",
    "scan:ict:mt5": "python -m backtesting.scan_ict_mt5",
    "test:trading": "python -m pytest -q execution/tests/test_demo_pipeline.py backtesting/tests/test_smc_runner.py backtesting/tests/test_cost_aware_engine.py",
    "ingest:ict:youtube": "python -m knowledge.videos.ingest_channel"
  }
}
