+"""Search Moil Bot's saved YouTube transcripts and local PDF references together."""
+
+import json
+import re
+from pathlib import Path
+
+import fitz
+
+from knowledge.search import DEFAULT_KNOWLEDGE_PATH
+
+DEFAULT_PDF_DIRECTORY = Path(__file__).resolve().parent / "documents"
+
+
+def _terms(query: str) -> list[str]:
+    return list(dict.fromkeys(re.findall(r"[a-z0-9]+", query.lower())))
+
+
+def _snippet(text: str, terms: list[str], max_length: int = 360) -> str:
+    if not text:
+        return ""
+
+    lowered = text.lower()
+    positions = [lowered.find(term) for term in terms if lowered.find(term) >= 0]
+    start_at = min(positions) if positions else 0
+    start = max(0, start_at - 100)
+    end = min(len(text), start + max_length)
+    excerpt = text[start:end].strip()
+
+    if start:
+        excerpt = "..." + excerpt
+    if end < len(text):
+        excerpt += "..."
+    return excerpt
+
+
+def _score(query: str, terms: list[str], title: str, text: str, concepts: list[str]) -> int:
+    title_lower = title.lower()
+    text_lower = text.lower()
+    concept_text = " ".join(concepts).lower()
+    phrase_pattern = re.compile(
+        r"\b" + r"\s+".join(re.escape(term) for term in terms) + r"\b"
+    )
+    score = 0
+
+    if query in [concept.lower().strip() for concept in concepts]:
+        score += 50
+    elif query in concept_text:
+        score += 30
+    if phrase_pattern.search(title_lower):
+        score += 35
+    if phrase_pattern.search(text_lower):
+        score += 20
+
+    title_terms = set(_terms(title_lower))
+    text_terms = set(_terms(text_lower))
+    concept_terms = set(_terms(concept_text))
+    if all(term in title_terms for term in terms):
+        score += 12
+    if all(term in concept_terms for term in terms):
+        score += 12
+    if all(term in text_terms for term in terms):
+        score += 8
+
+    for term in terms:
+        if term in title_terms:
+            score += 3
+        if term in concept_terms:
+            score += 2
+        if term in text_terms:
+            score += 1
+
+    return score
+
+
+def _load_video_records(knowledge_path: Path) -> list[dict]:
+    if not knowledge_path.exists():
+        return []
+
+    with knowledge_path.open("r", encoding="utf-8-sig") as file:
+        data = json.load(file)
+
+    records = data.get("records", []) if isinstance(data, dict) else []
+    return [record for record in records if isinstance(record, dict)] if isinstance(records, list) else []
+
+
+def _pdf_page_records(pdf_directory: Path) -> list[dict]:
+    if not pdf_directory.exists():
+        return []
+
+    records = []
+    for pdf_path in sorted(path for path in pdf_directory.rglob("*") if path.is_file() and path.suffix.lower() == ".pdf"):
+        try:
+            with fitz.open(pdf_path) as document:
+                for page_number, page in enumerate(document, start=1):
+                    text = page.get_text("text").strip()
+                    if not text:
+                        continue
+                    records.append({
+                        "title": pdf_path.stem,
+                        "text": text,
+                        "concepts": [],
+                        "source_type": "pdf",
+                        "location": str(pdf_path),
+                        "page": page_number,
+                        "url": None,
+                        "video_id": None,
+                    })
+        except (OSError, RuntimeError, ValueError):
+            # One damaged or password-protected PDF should not block other sources.
+            continue
+    return records
+
+
+def search_all_knowledge(
+    query: str,
+    limit: int = 10,
+    video_knowledge_path: str | Path | None = None,
+    pdf_directory: str | Path | None = None,
+) -> list[dict]:
+    """Search processed YouTube records and PDF pages, returning source-aware hits.
+
+    PDF files are discovered recursively beneath ``knowledge/documents`` by default.
+    Pass ``pdf_directory`` to use a different folder. Scanned/image-only PDFs need OCR
+    before their page text can be searched.
+    """
+    if not isinstance(query, str) or not query.strip():
+        return []
+    if not isinstance(limit, int) or isinstance(limit, bool) or limit < 1:
+        raise ValueError("limit must be a positive integer")
+
+    terms = _terms(query)
+    if not terms:
+        return []
+
+    normalized_query = " ".join(terms)
+    knowledge_path = Path(video_knowledge_path) if video_knowledge_path is not None else DEFAULT_KNOWLEDGE_PATH
+    pdf_root = Path(pdf_directory) if pdf_directory is not None else DEFAULT_PDF_DIRECTORY
+
+    candidates = []
+    for record in _load_video_records(knowledge_path):
+        title = str(record.get("title") or "Untitled video")
+        text = str(record.get("text") or "")
+        raw_concepts = record.get("concepts", [])
+        if not isinstance(raw_concepts, list):
+            raw_concepts = []
+        concepts = []
+        for concept in raw_concepts:
+            if concept is not None:
+                concepts.extend(part.strip() for part in str(concept).split(",") if part.strip())
+
+        score = _score(normalized_query, terms, title, text, concepts)
+        if score <= 0:
+            continue
+        candidates.append({
+            "title": title,
+            "source_type": "video",
+            "location": record.get("url") or record.get("video_id") or "",
+            "url": record.get("url"),
+            "video_id": record.get("video_id"),
+            "page": None,
+            "concepts": list(dict.fromkeys(concepts)),
+            "snippet": _snippet(text, terms),
+            "score": score,
+        })
+
+    for record in _pdf_page_records(pdf_root):
+        title = record["title"]
+        text = record["text"]
+        score = _score(normalized_query, terms, title, text, [])
+        if score <= 0:
+            continue
+        candidates.append({
+            "title": title,
+            "source_type": "pdf",
+            "location": record["location"],
+            "url": None,
+            "video_id": None,
+            "page": record["page"],
+            "concepts": [],
+            "snippet": _snippet(text, terms),
+            "score": score,
+        })
+
+    candidates.sort(key=lambda item: (-item["score"], item["source_type"], item["title"].lower(), item["page"] or 0))
+    return candidates[:limit]
