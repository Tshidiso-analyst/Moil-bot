def parse_form(body: bytes) -> dict[str, str]:

    parsed = urllib.parse.parse_qs(
        body.decode("utf-8")
    )

    return {
        key: values[0]
        for key, values in parsed.items()
    }


class MoilBotHandler(BaseHTTPRequestHandler):

    def send_html(
        self,
        page: str,
        status: int = 200,
    ) -> None:

        data = page.encode("utf-8")

        self.send_response(status)

        self.send_header(
            "Content-Type",
            "text/html; charset=utf-8",
        )

        self.send_header(
            "Content-Length",
            str(len(data)),
        )

        self.end_headers()

        self.wfile.write(data)

    def redirect(self, location: str) -> None:

        self.send_response(303)

        self.send_header(
            "Location",
            location,
        )

        self.end_headers()

    def do_GET(self) -> None:

        parsed = urllib.parse.urlparse(
            self.path
        )

        path = parsed.path

        query = urllib.parse.parse_qs(
            parsed.query
        )

        if path == "/":
            page = overview_page()

        elif path == "/markets":
            page = markets_page()

        elif path == "/analysis":
            page = analysis_page(query)

        elif path == "/trades":
            page = trades_page()

        elif path == "/alerts":
            page = simple_page(
                "Alerts",
                "Monitor Moil Bot notifications, trading alerts and system events.",
                "Alerts",
            )

        elif path == "/fundamentals":
            page = simple_page(
                "Fundamentals",
                "Review macroeconomic and fundamental market information.",
                "Fundamentals",
            )

        elif path == "/strategy":
            page = simple_page(
                "Strategy",
                "Manage strategy intelligence, versions and learning.",
                "Strategy",
            )

        elif path == "/risk":
            page = simple_page(
                "Risk",
                "Monitor account exposure, risk limits and trading safety.",
                "Risk",
            )

        elif path == "/disconnect":

            SESSION["connected"] = False
            SESSION["account"] = None
            SESSION["mode"] = None

            mt5_service.shutdown()

            self.redirect("/")

            return

        else:

            self.send_html(
                "<h1>404 - Page not found</h1>",
                404,
            )

            return

        self.send_html(page)

    def do_POST(self) -> None:

        parsed = urllib.parse.urlparse(
            self.path
        )

        if parsed.path != "/connect":

            self.send_html(
                "<h1>404 - Page not found</h1>",
                404,
            )

            return

        try:

            length = int(
                self.headers.get(
                    "Content-Length",
                    "0",
                )
            )

            body = self.rfile.read(length)

            form = parse_form(body)

            mode = form.get(
                "mode",
                "DEMO",
            ).upper()

            login_text = form.get(
                "login",
                "",
            )

            password = form.get(
                "password",
                "",
            )

            server = form.get(
                "server",
                "",
            )

            login = int(login_text)

            result = mt5_service.connect(
                login=login,
                password=password,
                server=server,
                requested_mode=mode,
            )

            if result.connected:

                SESSION["connected"] = True
                SESSION["account"] = result
                SESSION["mode"] = mode

                self.redirect("/")

                return

            SESSION["connected"] = False
            SESSION["account"] = None
            SESSION["mode"] = None

            page = layout(
                "Connection",
                connection_form(
                    result.message
                ),
                "Overview",
            )

            self.send_html(
                page,
                401,
            )

        except ValueError:

            page = layout(
                "Connection",
                connection_form(
                    "MT5 login must be a valid number."
                ),
                "Overview",
            )

            self.send_html(
                page,
                400,
            )

        except Exception as exc:

            page = layout(
                "Connection",
                connection_form(
                    f"Connection error: {exc}"
                ),
                "Overview",
            )

            self.send_html(
                page,
                500,
            )

    def log_message(
        self,
        format: str,
        *args: Any,
    ) -> None:

        print(
            f"[MOIL BOT] {format % args}"
        )


def main() -> None:

    server = ThreadingHTTPServer(
        (HOST, PORT),
        MoilBotHandler,
    )

    print()
    print("=" * 60)
    print("                 MOIL BOT")
    print("=" * 60)
    print()
    print(
        f"Dashboard running at:"
        f" http://{HOST}:{PORT}"
    )
    print()
    print("MT5 mode: READ-ONLY DASHBOARD")
    print("Order execution: DISABLED")
    print()
    print("Press CTRL+C to stop.")
    print("=" * 60)
    print()

    try:
        server.serve_forever()

    except KeyboardInterrupt:
        print()
        print("Stopping Moil Bot dashboard...")

    finally:
        mt5_service.shutdown()
        server.server_close()


if __name__ == "__main__":
    main()