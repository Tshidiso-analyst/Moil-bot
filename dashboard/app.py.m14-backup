}

/* ---------------- HERO SKULL ---------------- */

.skull-zone {
    position: absolute;

    right: 4%;
    top: 50%;

    width: 350px;
    height: 350px;

    transform: translateY(-50%);

    display: flex;
    align-items: center;
    justify-content: center;
}

.skull-aura {
    position: absolute;

    width: 300px;
    height: 300px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(255,100,0,.55),
            rgba(255,30,0,.20) 35%,
            rgba(100,0,255,.10) 65%,
            transparent 75%
        );

    filter: blur(20px);

    animation: aura 1.6s ease-in-out infinite;
}

@keyframes aura {
    0%, 100% {
        transform: scale(.92);
    }

    50% {
        transform: scale(1.12);
    }
}

.skull {
    position: relative;
    z-index: 4;

    font-size: 175px;

    filter:
        drop-shadow(0 0 8px white)
        drop-shadow(0 0 20px #ff6200)
        drop-shadow(0 0 50px #ff2200);

    animation:
        skullFloat 3.2s ease-in-out infinite,
        skullFire 1.2s ease-in-out infinite;
}

@keyframes skullFloat {
    0%, 100% {
        transform: translateY(0) rotate(-2deg);
    }

    50% {
        transform: translateY(-14px) rotate(2deg);
    }
}

@keyframes skullFire {
    0%, 100% {
        filter:
            drop-shadow(0 0 8px white)
            drop-shadow(0 0 18px #ff6200)
            drop-shadow(0 0 45px #ff2200);
    }

    50% {
        filter:
            drop-shadow(0 0 12px white)
            drop-shadow(0 0 30px #ff6200)
            drop-shadow(0 0 70px #ff2200);
    }
}

/* ---------------- FIRE PARTICLES ---------------- */

.fire-particle {
    position: absolute;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #ff8500;

    box-shadow:
        0 0 10px #ff6200,
        0 0 25px #ff2200;

    animation: rise 2.5s infinite ease-out;
}

.fire-particle.p1 {
    left: 30%;
    top: 72%;
}

.fire-particle.p2 {
    left: 52%;
    top: 75%;
    animation-delay: .6s;
}

.fire-particle.p3 {
    left: 68%;
    top: 68%;
    animation-delay: 1.1s;
}

@keyframes rise {
    from {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    to {
        transform:
            translateY(-180px)
            translateX(30px)
            scale(0);
        opacity: 0;
    }
}

/* ---------------- CARDS ---------------- */

.card {
    position: relative;

    background:
        linear-gradient(
            145deg,
            rgba(16,18,39,.91),
            rgba(6,7,19,.84)
        );

    border: 1px solid var(--border);

    border-radius: 18px;

    padding: 22px;

    box-shadow:
        0 20px 50px rgba(0,0,0,.25);

    backdrop-filter: blur(16px);
}

.card::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            #00eaff,
            #9b4dff,
            transparent
        );
}

.card h3 {
    margin-top: 0;
}

.grid {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(210px, 1fr)
        );

    gap: 18px;

    margin-top: 20px;
}

.metric {
    font-size: 30px;
    font-weight: 800;
}

.metric.positive {
    color: var(--green);
}

.metric.negative {
    color: #ff4f70;
}

.muted {
    color: var(--muted);
}

/* ---------------- BUTTONS ---------------- */

button,
.btn {
    border: 0;

    border-radius: 11px;

    padding: 12px 18px;

    color: white;

    font-weight: 700;

    background:
        linear-gradient(
            135deg,
            #008cff,
            #743cff
        );

    cursor: pointer;

    box-shadow:
        0 0 20px rgba(0,140,255,.20);
}

button:hover,
.btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 0 30px rgba(0,234,255,.35);
}

/* ---------------- INPUTS ---------------- */

input,
select {
    width: 100%;

    padding: 13px;

    border-radius: 10px;

    border: 1px solid rgba(255,255,255,.10);

    background: rgba(0,0,0,.38);

    color: white;

    outline: none;
}

input:focus,
select:focus {
    border-color: rgba(0,234,255,.55);

    box-shadow:
        0 0 20px rgba(0,234,255,.10);
}

label {
    display: block;

    color: #aab1c5;

    font-size: 12px;

    margin-bottom: 7px;
}

/* ---------------- STATUS ---------------- */

.status {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 6px 10px;

    border-radius: 999px;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .8px;

    text-transform: uppercase;
}

.status::before {
    content: "";

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: currentColor;

    box-shadow:
        0 0 10px currentColor;
}

.status.online {
    color: var(--green);

    background: rgba(54,226,140,.08);
}

.status.demo {
    color: var(--cyan);

    background: rgba(0,234,255,.08);
}

.status.offline {
    color: #ff536e;

    background: rgba(255,23,68,.08);
}

/* ---------------- TABLES ---------------- */

table {
    width: 100%;

    border-collapse: collapse;
}

th {
    padding: 12px;

    color: #7f879d;

    font-size: 10px;

    letter-spacing: 1px;

    text-align: left;

    text-transform: uppercase;
}

td {
    padding: 13px 12px;

    border-top: 1px solid rgba(255,255,255,.06);

    color: #e5e8f2;
}

tr:hover td {
    background: rgba(0,234,255,.025);
}

/* ---------------- TRADINGVIEW ---------------- */

.tv-chart {
    width: 100%;

    min-height: 620px;

    border-radius: 18px;

    overflow: hidden;

    border: 1px solid rgba(0,234,255,.14);

    box-shadow:
        0 0 35px rgba(0,0,0,.45);
}

.tv-chart iframe {
    width: 100%;
    height: 620px;

    border: 0;
}

/* ---------------- TOP BAR ---------------- */

.topbar {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 22px;
}

.topbar h1 {
    margin: 0;

    font-size: 27px;
}

.connection {
    display: flex;

    align-items: center;

    gap: 10px;
}

/* ---------------- FOOTER ---------------- */

.footer {
    margin-top: 35px;

    padding: 20px 0;

    color: #666d82;

    font-size: 11px;

    text-align: center;
}

/* ---------------- RESPONSIVE ---------------- */

@media(max-width: 1000px) {
    .sidebar {
        width: 210px;
    }

    .main {
        margin-left: 210px;
    }

    .skull-zone {
        right: -60px;
        opacity: .35;
    }
}

@media(max-width: 700px) {
    .sidebar {
        position: relative;
        width: 100%;
        min-height: auto;
    }

    .main {
        margin-left: 0;
        padding: 16px;
    }

    .hero {
        padding: 25px;
    }

    .hero-content {
        max-width: 100%;
    }

    .skull-zone {
        display: none;
    }

    .lightning {
        opacity: .20;
    }
}
</style>
"""


def esc(value: Any) -> str:
    return html.escape(str(value))


def money(value: Any, currency: str = "") -> str:
    try:
        number = float(value)
        return f"{currency} {number:,.2f}".strip()
    except (TypeError, ValueError):
        return f"{currency} 0.00".strip()


def layout(
    title: str,
    content: str,
    active: str = "Overview",
) -> str:

    nav_items = [
        ("Overview", "/"),
        ("Markets", "/markets"),
        ("Analysis", "/analysis"),
        ("Trades", "/trades"),
        ("Alerts", "/alerts"),
        ("Fundamentals", "/fundamentals"),
        ("Strategy", "/strategy"),
        ("Risk", "/risk"),
    ]

    nav = ""

    for name, url in nav_items:
        active_class = "active" if name == active else ""

        nav += f"""
        <a class="{active_class}" href="{url}">
            <span>{nav_icon(name)}</span>
            <span>{esc(name)}</span>
        </a>
        """

    account = SESSION.get("account")

    if SESSION.get("connected") and account:
        status = '<span class="status online">MT5 Connected</span>'
    else:
        status = '<span class="status offline">MT5 Offline</span>'

    return f"""
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title>Moil Bot — {esc(title)}</title>
    {CSS}
</head>

<body>

<div class="lightning-field">
    <div class="lightning one"></div>
    <div class="lightning two"></div>
    <div class="lightning three"></div>
</div>

<div class="electric-haze"></div>

<div class="app">

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-skull">
                💀
            </div>

            <h1>MOIL BOT</h1>

            <p>
                AI Trading Intelligence
            </p>

        </div>

        <nav class="nav">
            {nav}
        </nav>

        <div style="
            padding:20px;
            position:absolute;
            bottom:0;
            left:0;
            right:0;
        ">
            {status}
        </div>

    </aside>

    <main class="main">

        <div class="topbar">

            <div>
                <h1>{esc(title)}</h1>
            </div>

            <div class="connection">
                {status}
            </div>

        </div>

        {content}

        <div class="footer">
            MOIL BOT • MT5 MARKET INTELLIGENCE •
            DEMO-SAFE EXECUTION ARCHITECTURE
        </div>

    </main>

</div>

</body>
</html>
"""


def nav_icon(name: str) -> str:
    icons = {
        "Overview": "◈",
        "Markets": "◉",
        "Analysis": "⌁",
        "Trades": "⚡",
        "Alerts": "♢",
        "Fundamentals": "◫",
        "Strategy": "◇",
        "Risk": "△",
    }

    return icons.get(name, "◆")


def connection_form(message: str = "") -> str:
    message_html = ""

    if message:
        message_html = f"""
        <div class="card" style="
            margin-bottom:20px;
            border-color:rgba(255,70,100,.35);
        ">
            <strong>Connection message</strong>
            <p class="muted">{esc(message)}</p>
        </div>
        """

    return f"""
    {message_html}

    <div class="card">

        <h2>Connect MT5 Account</h2>

        <p class="muted">
            Connect a MetaTrader 5 account to load real account,
            market and position data.
        </p>

        <form method="POST" action="/connect">

            <div class="grid">

                <div>
                    <label>Account Mode</label>

                    <select name="mode" required>
                        <option value="DEMO">DEMO</option>
                        <option value="REAL">REAL</option>
                    </select>
                </div>

                <div>
                    <label>MT5 Login</label>

                    <input
                        type="number"
                        name="login"
                        placeholder="MT5 account number"
                        required
                    >
                </div>

                <div>
                    <label>MT5 Server</label>

                    <input
                        type="text"
                        name="server"
                        placeholder="Broker server"
                        required
                    >
                </div>

                <div>
                    <label>Password</label>

                    <input
                        type="password"
                        name="password"
                        placeholder="MT5 password"
                        required
                    >
                </div>

            </div>

            <div style="margin-top:20px;">
                <button type="submit">
                    CONNECT MT5
                </button>
            </div>

        </form>

        <p class="muted" style="
            margin-top:18px;
            font-size:11px;
        ">
            Your password is used only for the connection request and
            is not written to the dashboard session.
        </p>

    </div>
    """


def overview_page() -> str:

    account = SESSION.get("account")

    if not SESSION.get("connected") or not account:
        content = f"""
        <section class="hero">

            <div class="hero-content">

                <div class="status demo">
                    AI TRADING TERMINAL
                </div>

                <h2 style="margin-top:20px;">
                    <span>MOIL BOT</span>
                    <span>IS ONLINE.</span>
                </h2>

                <p>
                    Real MetaTrader 5 market intelligence,
