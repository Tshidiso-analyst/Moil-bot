    symbol = query.get("symbol", ["EURUSD"])[0]

    tv_symbol = TRADINGVIEW_MAP.get(
        symbol.upper(),
        f"OANDA:{symbol.upper()}",
    )

    market = None

    if SESSION.get("connected"):
        market = mt5_service.symbol(symbol)

    market_html = ""

    if market:
        digits = market["digits"]

        market_html = f"""
        <div class="grid">

            <div class="card">
                <div class="muted">MT5 BID</div>

                <div class="metric">
