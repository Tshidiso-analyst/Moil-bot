}

/* ---------------- HERO ---------------- */

.hero {
    position: relative;
    overflow: hidden;

    min-height: 390px;

    padding: 45px;

    border-radius: 28px;

    background:
        radial-gradient(
            circle at 80% 50%,
            rgba(255,70,0,.16),
            transparent 23%
        ),
        radial-gradient(
            circle at 75% 45%,
            rgba(0,234,255,.13),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            rgba(14,16,36,.96),
