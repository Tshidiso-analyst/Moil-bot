                <div class="muted">MT5 SPREAD</div>

                <div class="metric">
                    {market["spread"]:.{digits}f}
                </div>
            </div>

        </div>
        """

    content = f"""
    <div class="card">

        <h2>
            {esc(symbol)}
        </h2>

        <p class="muted">
            TradingView is shown as the charting layer.
            MT5 market data is shown separately below.
