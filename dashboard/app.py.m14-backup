CSS = r"""
<style>
:root {
    --bg: #020208;
    --panel: rgba(10, 11, 25, 0.88);
    --panel2: rgba(17, 18, 38, 0.94);
    --border: rgba(255,255,255,.10);
    --text: #f5f7ff;
    --muted: #8d94aa;
    --cyan: #00eaff;
    --blue: #168cff;
    --purple: #9b4dff;
    --red: #ff1744;
    --orange: #ff6200;
    --yellow: #ffd000;
    --green: #36e28c;
}

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background:
        radial-gradient(circle at 50% -10%, rgba(89,0,190,.35), transparent 35%),
        radial-gradient(circle at 0% 100%, rgba(0,140,255,.12), transparent 32%),
        radial-gradient(circle at 100% 70%, rgba(255,20,70,.08), transparent 30%),
        #020208;
    color: var(--text);
    font-family: Inter, Segoe UI, Arial, sans-serif;
}

body {
    overflow-x: hidden;
}

/* ---------------- SPACE ---------------- */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -20;
    pointer-events: none;

    background-image:
        radial-gradient(1px 1px at 10% 20%, white, transparent),
        radial-gradient(1px 1px at 22% 72%, rgba(255,255,255,.8), transparent),
        radial-gradient(1px 1px at 36% 35%, rgba(0,234,255,.9), transparent),
        radial-gradient(1px 1px at 52% 82%, white, transparent),
        radial-gradient(1px 1px at 67% 22%, rgba(255,255,255,.9), transparent),
        radial-gradient(1px 1px at 81% 62%, rgba(0,234,255,.8), transparent),
        radial-gradient(2px 2px at 92% 18%, rgba(155,77,255,.9), transparent);

    background-size:
        170px 170px,
        210px 210px,
        240px 240px,
        280px 280px,
        190px 190px,
        250px 250px,
        320px 320px;

    animation: stars 45s linear infinite;
}

@keyframes stars {
    from {
        transform: translateY(0);
    }

    to {
        transform: translateY(-150px);
    }
}

/* ---------------- LIGHTNING ---------------- */

.lightning-field {
    position: fixed;
    inset: 0;
    z-index: -8;
    pointer-events: none;
    overflow: hidden;
}

.lightning {
    position: absolute;

    width: 10px;
    height: 90vh;

    background: linear-gradient(
        to bottom,
        transparent,
        #00eaff 18%,
        #ffffff 42%,
        #00eaff 60%,
        rgba(0,234,255,.15) 88%,
        transparent
    );

    clip-path: polygon(
        46% 0%,
        64% 11%,
        43% 13%,
        72% 29%,
        51% 31%,
        80% 48%,
        58% 51%,
        88% 67%,
        60% 70%,
        73% 86%,
        47% 100%,
        51% 84%,
        34% 83%,
        46% 68%,
        24% 66%,
        42% 50%,
        22% 48%,
        43% 31%,
        28% 29%,
        44% 14%,
        33% 12%
    );

    filter:
        drop-shadow(0 0 5px #00eaff)
        drop-shadow(0 0 20px #008cff)
        drop-shadow(0 0 45px #00eaff);

    opacity: .65;

    animation:
        lightningFlash 4s infinite,
        lightningMove 7s ease-in-out infinite;
}

.lightning.one {
    left: 5%;
    top: -10%;
    transform: rotate(-12deg) scale(1.1);
}

.lightning.two {
    right: 5%;
    top: -4%;
    transform: rotate(14deg) scale(1.2);
    animation-delay: 1.1s;
}

.lightning.three {
    left: 47%;
    top: -25%;
    height: 70vh;
    transform: rotate(3deg) scale(.65);
    opacity: .4;
    animation-delay: 2.2s;
}

@keyframes lightningFlash {
    0%, 82%, 100% {
        opacity: .25;
    }

    84% {
        opacity: 1;
    }

    85% {
        opacity: .1;
    }

    86% {
        opacity: .95;
    }

    89% {
        opacity: .3;
    }
}

@keyframes lightningMove {
    0%, 100% {
        filter:
            drop-shadow(0 0 5px #00eaff)
            drop-shadow(0 0 20px #008cff)
            drop-shadow(0 0 45px #00eaff);
    }

    50% {
        filter:
            drop-shadow(0 0 10px white)
            drop-shadow(0 0 35px #00eaff)
            drop-shadow(0 0 70px #168cff);
    }
}

.electric-haze {
    position: fixed;
    inset: 0;
    z-index: -9;
    pointer-events: none;

    background:
        radial-gradient(
            ellipse at center,
            transparent 30%,
            rgba(0,234,255,.04) 58%,
            rgba(100,30,255,.12) 100%
        );

    animation: haze 5s ease-in-out infinite;
}

@keyframes haze {
    0%, 100% {
        opacity: .65;
    }

    50% {
        opacity: 1;
    }
}

/* ---------------- LAYOUT ---------------- */

.app {
    min-height: 100vh;
}

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;

    width: 250px;

    background:
