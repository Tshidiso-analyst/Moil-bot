            180deg,
            rgba(3,4,12,.97),
            rgba(8,6,20,.94)
        );

    border-right: 1px solid rgba(0,234,255,.13);

    box-shadow:
        10px 0 50px rgba(0,0,0,.45);

    z-index: 50;
}

.main {
    margin-left: 250px;
    padding: 30px;
    min-height: 100vh;
}

/* ---------------- BRAND ---------------- */

.brand {
    padding: 25px 20px;
    border-bottom: 1px solid var(--border);
}

.brand-skull {
    width: 82px;
    height: 82px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 55px;

    border-radius: 23px;

    background:
        radial-gradient(
            circle,
            rgba(255,70,0,.35),
            rgba(130,0,255,.12) 65%,
            transparent 75%
        );

    border: 1px solid rgba(255,70,0,.35);

    box-shadow:
        0 0 20px rgba(255,70,0,.65),
        0 0 60px rgba(255,30,0,.25);

    animation: skullPulse 2s ease-in-out infinite;
}

@keyframes skullPulse {
    0%, 100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.07);
    }
}

.brand h1 {
    margin: 13px 0 0;

    font-size: 25px;
    letter-spacing: 3px;

    background:
        linear-gradient(
            90deg,
            white,
            #00eaff,
            #9b4dff,
            #ff4d00,
            white
        );

    background-size: 400% 100%;

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;

    animation: brandFlow 6s linear infinite;
}

@keyframes brandFlow {
    from {
        background-position: 0%;
    }

    to {
        background-position: 400%;
    }
}

.brand p {
    margin: 5px 0 0;

    font-size: 10px;
    color: var(--muted);

    letter-spacing: 1.8px;
    text-transform: uppercase;
}

/* ---------------- NAV ---------------- */

.nav {
