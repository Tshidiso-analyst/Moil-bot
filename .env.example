# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smc_trading_ai
DB_USER=postgres
DB_PASSWORD=your_postgresql_password

# MetaTrader 5
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Application
APP_ENV=development
LOG_LEVEL=INFO
# Economic calendar feed (optional; required for verified event coverage)
# Provider options: http (default) or fmp.
# FMP calendar access requires a subscription tier that includes the endpoint.
MOILBOT_CALENDAR_PROVIDER=http
MOILBOT_CALENDAR_URL=
MOILBOT_CALENDAR_TOKEN=
MOILBOT_FMP_API_KEY=
MOILBOT_FMP_CALENDAR_DAYS=7
MOILBOT_FMP_CALENDAR_COUNTRY=
MOILBOT_CALENDAR_TIMEOUT=8
MOILBOT_CALENDAR_MAX_AGE_SECONDS=900
MOILBOT_CALENDAR_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
MOILBOT_CALENDAR_POLL_SECONDS=300
